# Admin panel: qidiruv tizimlariga chiqmaydi, boshqa saytga ramka ichida qo'yib bo'lmaydi
/admin/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Cache-Control: no-cache

# Hamma fayllar: brauzer fayl turini taxmin qilmasin, boshqa saytlarga to'liq manzil yuborilmasin
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
